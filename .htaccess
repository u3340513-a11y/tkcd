# ---------------------------------------------------------------------------
# Trabzonlu Kamu Çalışanları Derneği - kök dizin yapılandırması
#
# cPanel'de bu dizin (public_html) alan adının kök dizinidir. Uygulamanın
# gerçek giriş noktası /public klasörüdür; app, config, resources ve storage
# klasörleri tarayıcıdan asla erişilebilir olmamalıdır.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Uygulama dizinlerine doğrudan HTTP erişimini engelle.
    RewriteRule ^(app|config|resources|storage|images)(/|$) - [F,L]

    # Nokta ile başlayan gizli dosyalara erişimi engelle (.env, .git vb.).
    # .well-known dizini AutoSSL sertifika doğrulaması için açık kalmalıdır.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\. - [F,L]

    # Tüm istekleri public/ önyüzüne yönlendir.
    # Yönetim paneli (/yonetim/) ve .well-known bu kuraldan muaftır.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !^/yonetim/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Dizin listelemesini kapat.
Options -Indexes

# Hassas dosya uzantılarını kapat.
<FilesMatch "\.(env|ini|log|sh|sql|md|json|lock|yml|yaml)$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------------
# Güvenlik HTTP başlıkları
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    # MIME türü tahmini saldırılarını engelle.
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking koruması: bu site yalnızca kendi frame'lerinde açılabilir.
    Header always set X-Frame-Options "SAMEORIGIN"

    # Referer bilgisi sızıntısını minimize et.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Tarayıcı API izinlerini kısıtla.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # İçerik güvenlik politikası: yalnızca izin verilen kaynaklardan yükleme.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https: blob:; connect-src 'self' https://www.youtube-nocookie.com https://www.youtube.com; frame-src 'self' https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self' blob: https://www.youtube-nocookie.com https://www.youtube.com https://*.googlevideo.com; upgrade-insecure-requests"
</IfModule>
