# ---------------------------------------------------------------------------
# Ortam değişkenleri şablonu.
# Bu dosyayı ".env" adıyla kopyalayıp sunucuya özel değerleri doldurunuz.
# .env dosyası ASLA sürüm kontrolüne eklenmemelidir.
# ---------------------------------------------------------------------------

# local | production
APP_ENV=production
APP_DEBUG=false
APP_URL=https://trabzonlukamucalisanlaridernegi.com
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr_TR

# Kurum bilgileri
SITE_NAME="Trabzonlu Kamu Çalışanları Derneği"
SITE_SHORT_NAME="TKÇD"
SITE_EMAIL=info@trabzonlukamucalisanlaridernegi.com
SITE_PHONE="+90 535 418 61 61"
SITE_ADDRESS="Fatih Mah. Yavuz Selim Cad. 34134 İstanbul / TÜRKİYE"

# Sosyal medya
SOCIAL_FACEBOOK=https://www.facebook.com/p/Trabzonlu-kamu-%C3%A7al%C4%B1%C5%9Fanlar%C4%B1-derne%C4%9Fi-61585515402722/
SOCIAL_X=https://x.com/TrabzonluKCD
SOCIAL_INSTAGRAM=https://www.instagram.com/trabzonlukamucalisanlariderngi/
SOCIAL_YOUTUBE=https://www.youtube.com/@TrabzonluKamuCalisanlarDernegi
SOCIAL_WHATSAPP=https://wa.me/905354186161

# Üyelik başvuru formu bağlantısı (Google Form vb.)
MEMBERSHIP_FORM_URL=/uye-ol

# Anasayfadaki tanıtım bölümünün arka planında oynatılan YouTube videosu.
# Yalnızca video kimliği girilir (https://www.youtube.com/watch?v=BU_KISIM).
SITE_PROMO_VIDEO_ID=ELbwpC0AYhA

# Analitik (boş bırakılırsa hiçbir script yüklenmez)
